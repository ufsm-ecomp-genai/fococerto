# FocoCerto configuration. Copy to .env and fill in. Placeholders only: never commit real values.
# Sample mode (`python -m app.cli run --sample`) needs none of these.

# --- LLM provider (all LLM calls go through app/llm/client.py) ---
# nightshift = Meterless Nightshift (primary); offline = deterministic agents, no LLM call
LLM_PROVIDER=nightshift
# Nightshift OpenAI-compatible endpoint (from the host use localhost; from Docker use host.docker.internal)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-with-your-nightshift-runtime-token
# Model routed by Nightshift
METERLESS_MODEL=meterless/auto
METERLESS_APP=fococerto
METERLESS_SCOPE=user
# Optional LLM tuning (defaults shown)
LLM_TIMEOUT_S=180
LLM_RETRIES=3
LLM_BACKOFF_S=2
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# 1 = ask the model to skip "thinking" output
LLM_NO_THINK=1

# --- Zetaris (read-only data layer) ---
# Without ZETARIS_API_KEY the CLI falls back to the local cache in data/cache/
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace-with-your-zetaris-api-key
ZETARIS_ORG_ID=1
# Used by scripts/setup_zetaris.py only
# Host the Zetaris containers use to reach Postgres
ZETARIS_PG_HOST=host.docker.internal
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1
ZETARIS_FILESTORE_DIR=/home/zetaris/customer-data/shared/fococerto

# --- Postgres (direct writes: approved decisions and coordinator notes) ---
POSTGRES_DSN=postgresql://postgres:dev@localhost:55432/postgres
# Optional: enables the Postgres write test in tests/test_dados_repositorio.py (use a throwaway DB)
# POSTGRES_DSN_TESTE=postgresql://postgres:dev@localhost:55432/fococerto_test

# --- Meterless H-MEM service (services/hmem, `npm start`) ---
# Without HMEM_URL the CLI uses the in-process MemoriaLocal (data/estado/)
HMEM_URL=http://127.0.0.1:7070
# Read by the service itself
HMEM_HOST=127.0.0.1
HMEM_PORT=7070
# Where the service persists memories (default services/hmem/data; ":memory:" = no persistence)
HMEM_DATA_DIR=./services/hmem/data
# coordenador_mais_recente (newest coordinator note wins) | fila (conflict stays queued)
HMEM_POLITICA_NOTAS=coordenador_mais_recente
